DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/home_server
PG_MAX_CONNECTIONS=10
METRICS_CACHE_TTL_MS=2000
METRICS_PUBLISH_INTERVAL_MS=2000
SSE_HEARTBEAT_MS=8000
WEBSOCKET_ENABLED=true
# REQUIRED: change this to a random string of at least 32 characters before deploying
AUTH_SESSION_SECRET=dev-session-secret-change-me
AUTH_SESSION_HOURS=168
AUTH_PRIMARY_USERNAME=admin
# Optional: set this to auto-seed principal user during `npm run db:init`
# AUTH_PRIMARY_PASSWORD=change-me-strong
# Single-user mode: registration is disabled after first setup. Set to true only for initial setup.
NEXT_PUBLIC_PRIMARY_USERNAME=admin
LOG_LEVEL=info
LOG_FILE_PATH=logs/home-server.log
LOG_TO_FILE=true
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_CLIENT_LOG_INGEST=true
STORE_TEMPLATE_URL=https://raw.githubusercontent.com/bigbeartechworld/big-bear-portainer/main/templates.json
STORE_CATALOG_TTL_MS=21600000  # 6 hours
STORE_MAX_CONCURRENT_OPERATIONS=3
STORE_STACKS_ROOT=/var/lib/home-server/stacks  # Stack files (compose + env)
STORE_APP_DATA_ROOT=/DATA/Apps  # App persistent data (volumes)
FILES_ROOT=/DATA  # Files app exposed root
FILES_ALLOW_HIDDEN=false  # Allow hidden files toggle in Files app
# Wall-clock budget (ms) for the recursive file-search walk. On a Pi
# with a large NAS share mounted at FILES_ROOT, raise this if you need
# deeper searches; lower it for faster UI feedback.
# Minimum: 1000. Default: 10000.
FILES_SEARCH_TIMEOUT_MS=10000
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Rootless Podman containers (e.g. quadlets under a user's own systemd session)
# live in a separate container store from the rootful socket above and are
# otherwise invisible to Homeio. Point this at that user's socket (e.g.
# /run/user/<uid>/podman/podman.sock) to surface them too. Optional.
# PODMAN_ROOTLESS_SOCKET_PATH=
# Max wall-clock time (ms) for any `docker compose` subprocess (pull/up/down/ps).
# Raise on slow Pi internet links; lower for faster failure feedback.
# Minimum: 30000. Default: 300000 (5 minutes).
DOCKER_COMPOSE_TIMEOUT_MS=300000
# Anonymous usage stats — random instance ID, version, arch, OS, Docker or not,
# and the Linux distribution with its version (not in Docker), sent every
# 12 hours in production. Public totals: https://homeio.app/stats
# HOMEIO_TELEMETRY=false  # uncomment to disable (also locks the Settings toggle off)
# HOMEIO_TELEMETRY_URL=https://homeio.app/api/stats
# Updates follow published GitHub releases. Set a branch to follow it instead,
# for example a testing line; the in-app update then installs that branch.
# HOMEIO_REPO_BRANCH=v2.0
